{
  "pluginId": "cydectin-injectable",
  "displayName": "Cydectin Injectable (moxidectin) for Cattle",
  "version": "1.0.0",
  "type": "animal-health",
  "productKind": "dewormer",
  "activeIngredients": [
    {
      "name": "Moxidectin"
    }
  ],
  "approval": {
    "kind": "NADA",
    "number": "141-220"
  },
  "marketingStatus": "otc",
  "labelUses": [
    {
      "speciesId": "cattle",
      "class": "all",
      "routes": [
        "injection-sc"
      ],
      "withdrawal": {
        "meatDays": 21
      }
    },
    {
      "speciesId": "cattle",
      "class": "lactating-dairy",
      "routes": [
        "injection-sc"
      ],
      "withdrawal": {
        "doNotUseFor": [
          "milk"
        ]
      }
    }
  ],
  "notes": "For beef and nonlactating dairy cattle. The label also says a withdrawal period has not been established for preruminating calves and not to use in calves to be processed for veal."
}
