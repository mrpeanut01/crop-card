      "windows": [
        {
          "id": "pink-diseases",
          "purpose": "disease-risk",
          "targets": [
            {
              "id": "apple-scab",
              "kind": "disease"
            },
            {
              "id": "apple-rusts",
              "kind": "disease"
            },
            {
              "id": "powdery-mildew",
              "kind": "disease"
            },
            {
              "id": "fire-blight",
              "kind": "disease"
            }
          ],
          "pollinatorSensitive": true,
          "note": "Pink through petal fall is a critical time for quince rust in orchards that have had it.",
          "sourceKeys": ["pome-va-2026.pink.diseases"]
        },
        {
          "id": "pink-pests",
          "purpose": "pest-risk",
          "targets": [
            {
              "id": "defoliating-caterpillars",
              "kind": "pest"
            },
            {
              "id": "european-red-mite",
              "kind": "pest"
            },
            {
              "id": "european-apple-sawfly",
              "kind": "pest"
            },
            {
              "id": "oriental-fruit-moth",
              "kind": "pest"
            },
            {
              "id": "mullein-bug",
              "kind": "pest"
            },
            {
              "id": "dogwood-borer",
              "kind": "pest"
            },
            {
              "id": "codling-moth",
              "kind": "pest"
            },
            {
              "id": "green-fruitworm",
              "kind": "pest"
            }
          ],
          "pollinatorSensitive": true,
          "note": "European apple sawfly is listed at pink only where its damage was severe the year before.",
          "sourceKeys": ["pome-va-2026.pink.pests"]
        },
        {
          "id": "pink-traps",
          "purpose": "scout",
          "targets": [
            {
              "id": "san-jose-scale",
              "kind": "pest"
            },
            {
              "id": "spongy-moth",
              "kind": "pest"
            }
          ],
          "pollinatorSensitive": true,
          "note": "Hang a pheromone trap and check it for male San Jose scale. Start watching for spongy moth (gypsy moth).",
          "sourceKeys": ["pome-va-2026.pink.traps"]
        },
        {
          "id": "pink-sawfly-traps",
          "purpose": "scout",
          "targets": [
            {
              "id": "european-apple-sawfly",
              "kind": "pest"
            }
          ],
          "pollinatorSensitive": true,
          "note": "White sticky traps catch European apple sawfly adults between pink and petal fall.",
          "sourceKeys": ["pome-va-2026.pink.sawfly"]
        }
      ]
    },
    {
      "id": "bloom",
