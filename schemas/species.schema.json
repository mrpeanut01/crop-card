{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cropcard.dev/schemas/species.schema.json",
  "title": "CropCard Species Plugin",
  "description": "Data-only animal species definition: names, group noun, product types, the default food-producing flag and care cadence defaults. foodProducingDefault and every care intervalDays need a quoted source in apps/web/scripts/species-sources.json. Loaded from plugins/species/. Mirrors packages/plugin-validation/src/schemas.ts (speciesPluginSchema).",
  "type": "object",
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "pluginSchemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "type": {
      "type": "string",
      "const": "species"
    },
    "scientificName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "groupNoun": {
      "type": "string",
      "enum": [
        "flock",
        "herd",
        "litter",
        "colony",
        "group"
      ]
    },
    "foodProducingDefault": {
      "type": "boolean"
    },
    "notForSlaughterToggle": {
      "type": "boolean"
    },
    "products": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "meat",
          "eggs",
          "milk",
          "fiber",
          "breeding",
          "work",
          "companion"
        ]
      }
    },
    "tile": {
      "type": "object",
      "properties": {
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "icon"
      ],
      "additionalProperties": false
    },
    "careDefaults": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "vaccination",
              "deworm",
              "hoof-trim",
              "shearing",
              "health-check",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "intervalDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3650
          },
          "note": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "key",
          "kind",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "housingSpace": {
      "type": "object",
      "properties": {
        "indoorSqFtPerAnimal": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "outdoorSqFtPerAnimal": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "sourceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "sourceName"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "pluginId",
    "displayName",
    "version",
    "type",
    "groupNoun",
    "foodProducingDefault",
    "products",
    "tile"
  ],
  "additionalProperties": false
}
