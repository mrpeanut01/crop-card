# Copy this file to .env for local development.

# --- Auth.js ---
AUTH_SECRET=change-me-to-a-random-32-byte-base64-string
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:5173

# --- Email (magic links) ---
# Resend free tier (3k/mo) or any SMTP-compatible provider
EMAIL_FROM=cropcard@example.com
RESEND_API_KEY=

# --- Database ---
DATABASE_URL=file:/data/cropcard.db

# --- Azure Blob (used in dev via Azurite emulator) ---
# Local dev: docker-compose reads infra/.env.dev for the connection string.
#   cp infra/.env.dev.example infra/.env.dev   then paste the Azurite
# well-known account key from https://learn.microsoft.com/azure/storage/common/storage-use-azurite
# into the AccountKey portion. (It's a hardcoded test value, but kept out of
# git to keep the GitHub secret scanner happy.)
# Production: Bicep injects the real Azure Storage account key via Key Vault.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=cropcard
