    "leafminer",
    "diamondback moth",
    "Colorado potato beetle",
    "armyworm",
    "cabbage looper"
  ],
  "pollinatorRisk": "moderate",
  "notes": "OMRI-listed organic spinosad. Same a.i. as Tracer/Success — different formulation. Apply at sunset to avoid bee toxicity.",
  "complianceFlags": {
    "omriListed": false,
    "certifiedOrganicAllowed": false,
    "nonGmoCompliant": true,
    "transitioningAllowed": false
  },
  "pluginSchemaVersion": "1.1",
  "scoutingThresholds": [
    {
      "pest": "thrips",
      "metric": "count-per-leaf",
      "threshold": 4,
      "warnAt": 2
    },
    {
      "pest": "leafminer",
      "metric": "count-per-leaf",
      "threshold": 5,
      "warnAt": 3
    },
    {
      "pest": "diamondback moth",
      "metric": "count-per-plant",
      "threshold": 0.3
    },
    {
      "pest": "Colorado potato beetle",
      "metric": "count-per-plant",
      "threshold": 2,
      "warnAt": 1
    },
    {
      "pest": "cabbage looper",
      "metric": "count-per-plant",
      "threshold": 0.5
    }
  ]
}
