    {
      "name": "clothianidin",
      "iracGroup": "4A"
    }
  ],
  "reEntryIntervalHours": 12,
  "preHarvestIntervalDays": 7,
  "ratePerAcre": {
    "amount": 6,
    "unit": "fl-oz"
  },
