{
  "name": "crop-card",
  "version": "0.0.1",
  "private": true,
  "description": "CropCard — offline-first PWA replacing the paper Field Card for small-plot row crop herbicide planning, planting, and harvest tracking.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @cropcard/web dev",
    "build": "pnpm --filter @cropcard/web build",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @cropcard/web test:unit",
    "test:e2e": "pnpm --filter @cropcard/web test:e2e",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @cropcard/web db:generate",
    "db:migrate": "pnpm --filter @cropcard/web db:migrate",
    "db:reset": "pnpm --filter @cropcard/web db:reset",
    "gen:safety-snapshot": "pnpm --filter @cropcard/plugin-validation gen:safety-snapshot"
  }
}
