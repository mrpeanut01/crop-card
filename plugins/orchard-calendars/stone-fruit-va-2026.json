              "kind": "pest"
            },
            {
              "id": "stink-bugs",
              "kind": "pest"
            },
            {
              "id": "oriental-fruit-moth",
              "kind": "pest"
            },
            {
              "id": "periodical-cicada",
              "kind": "pest"
            },
            {
              "id": "lesser-peachtree-borer",
              "kind": "pest"
            },
            {
              "id": "plum-curculio",
              "kind": "pest"
            },
            {
              "id": "western-flower-thrips",
              "kind": "pest"
            },
            {
              "id": "leafrollers",
              "kind": "pest"
            },
            {
              "id": "japanese-beetle",
              "kind": "pest"
            },
            {
              "id": "european-red-mite",
              "kind": "pest"
            },
            {
              "id": "two-spotted-spider-mite",
              "kind": "pest"
            }
          ],
          "pollinatorSensitive": false,
          "note": "Listed for first through fifth cover. Check the label.",
          "sourceKeys": ["stone-fruit-va-2026.covers.pests"]
