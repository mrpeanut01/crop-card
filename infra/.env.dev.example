# Copy to infra/.env.dev (gitignored). docker-compose reads it at boot.
#
# AZURE_STORAGE_CONNECTION_STRING — point at the local Azurite emulator.
# The AccountKey below is Azurite's well-known dev credential, documented at:
#   https://learn.microsoft.com/azure/storage/common/storage-use-azurite
# It's the same constant for every Azurite install on the planet — there is
# no security risk in using it for local dev. We keep it out of source so
# GitHub's secret scanner doesn't pattern-match the format.
#
# Paste the literal AccountKey from the Microsoft docs into the line below.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=PASTE_AZURITE_WELL_KNOWN_KEY_FROM_MICROSOFT_DOCS;BlobEndpoint=http://azurite:10000/devstoreaccount1;
