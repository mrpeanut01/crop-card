{
  "name": "@cropcard/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "rm -f /data/cropcard.db && pnpm db:migrate",
    "seed:test": "node scripts/seed-test-data.mjs",
    "gen:schemas": "tsx scripts/gen-schemas.mjs",
    "gen:openapi": "tsx --tsconfig scripts/tsconfig.openapi.json scripts/gen-openapi.mjs",
    "audit:plugins": "node scripts/auditPluginDiscriminators.mjs",
    "enhance:plugins": "node scripts/enhancePluginDiscriminators.mjs",
    "backfill:archetype": "node scripts/backfill-archetype.mjs",
    "audit:plugin-metadata": "tsx scripts/plugin-metadata-audit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.3.15",
    "@vite-pwa/sveltekit": "^1.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cropcard": "workspace:*",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^3.2.8",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@cropcard/plugin-validation": "workspace:*",
    "@geoman-io/leaflet-geoman-free": "^2.20.2",
    "@zxing/library": "^0.23.0",
    "better-sqlite3": "^13.0.3",
    "dexie": "^4.4.6",
    "drizzle-orm": "^0.45.3",
    "leaflet": "^1.9.4",
    "lucide-svelte": "^1.0.1",
    "papaparse": "^5.7.0",
    "pdfmake": "^0.3.11",
    "zod": "^4.6.5"
  }
}
