{
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "$id": "https://cropcard.dev/schemas/herbicide.schema.json",
  "title": "CropCard Herbicide Plugin",
  "description": "Data-only herbicide definition. Mirrors apps/web/src/lib/plugins/schemas.ts (herbicidePluginSchema). complianceFlags (Phase 21) drives the philosophy filter on the Inputs Plan step.",
  "type": "object",
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "pluginSchemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "type": {
      "type": "string",
      "const": "herbicide"
    },
    "activeIngredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "chemistryClass": {
            "type": "string",
            "enum": [
              "synthetic-auxin",
              "chloroacetamide",
              "hppd-inhibitor",
              "accase-inhibitor",
              "glyphosate",
              "sulfonylurea",
              "microtubule-inhibitor",
              "photosystem-ii-triazine",
              "photosystem-i-diquat",
              "glufosinate",
              "ppo-inhibitor",
              "als-imidazolinone",
              "vlcfa-pyroxasulfone",
              "clomazone"
            ]
          }
        },
        "required": [
          "name",
          "chemistryClass"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "applicationTiming": {
      "type": "string",
      "enum": [
        "BURNDOWN",
        "PRE",
        "POST",
        "POST-DIRECTED"
      ]
    },
    "ratePerAcre": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "exclusiveMinimum": true,
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "oz",
            "fl-oz",
            "lb",
            "pt",
            "qt"
          ]
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "additionalProperties": false
    },
    "gpaCalibration": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0,
      "default": 15
    },
    "dilutionTable": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "enum": [
              "oz",
              "fl-oz",
              "lb",
              "pt",
              "qt"
            ]
          },
          "display": {
            "type": "string"
          }
        },
        "required": [
          "amount",
          "unit"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^\\d+gal$"
      }
    },
    "acresPerTank": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": true,
        "minimum": 0
      },
      "propertyNames": {
        "pattern": "^\\d+gal$"
      }
    },
    "requiresAMS": {
      "type": "boolean"
    },
    "deconRequired": {
      "type": "boolean"
    },
    "tankMixOrder": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "epaRegistrationNumber": {
      "type": "string",
      "pattern": "^\\d{1,6}-\\d{1,6}(-\\d{1,6})?$"
    },
    "ratesPerZone": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "zone": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "enum": [
              "oz",
              "fl-oz",
              "lb",
              "pt",
              "qt"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "zone",
          "amount",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "traitGatedSafeFor": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cropPluginId": {
            "type": "string"
          },
          "requiresTraits": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "minItems": 1
          }
        },
        "required": [
          "cropPluginId",
          "requiresTraits"
        ],
        "additionalProperties": false
      }
    },
    "labelClaims": {
      "type": "object",
      "properties": {
        "safeForCropPluginIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "complianceFlags": {
      "type": "object",
      "properties": {
        "omriListed": {
          "type": "boolean"
        },
        "nonGmoCompliant": {
          "type": "boolean"
        },
        "certifiedOrganicAllowed": {
          "type": "boolean"
        },
        "transitioningAllowed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "pluginId",
    "displayName",
    "version",
    "type",
    "activeIngredients",
    "ratePerAcre"
  ],
  "additionalProperties": false
}
