{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cropcard.dev/schemas/bed-recipe.schema.json",
  "title": "CropCard Bed Recipe Plugin",
  "description": "Data-only garden bed recipe: a timed sequence of crops that fills one bed, anchored to the last spring frost, the first fall frost or the end of an earlier step. Every cropPluginId and alternate must name a registered crop plugin. Loaded from plugins/bed-recipes/. Mirrors packages/plugin-validation/src/schemas.ts (bedRecipePluginSchema).",
  "type": "object",
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "pluginSchemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "type": {
      "type": "string",
      "const": "bed-recipe"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "bedSize": {
      "type": "object",
      "properties": {
        "widthFt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "lengthFt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200
        }
      },
      "required": [
        "widthFt",
        "lengthFt"
      ],
      "additionalProperties": false
    },
    "frostFreeDays": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 366
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 366
        }
      },
      "required": [
        "min"
      ],
      "additionalProperties": false
    },
    "zoneLabel": {
      "type": "string",
      "maxLength": 40
    },
    "steps": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cropPluginId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "alternates": {
            "default": [],
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "start": {
            "type": "object",
            "properties": {
              "anchor": {
                "type": "string",
                "enum": [
                  "last-spring-frost",
                  "first-fall-frost",
                  "after-step"
                ]
              },
              "offsetDays": {
                "type": "integer",
                "minimum": -180,
                "maximum": 180
              },
              "afterStep": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "anchor",
              "offsetDays"
            ],
            "additionalProperties": false
          },
          "section": {
            "default": {
              "x": 0,
              "y": 0,
              "w": 1,
              "l": 1
            },
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "l": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "l"
            ],
            "additionalProperties": false
          },
          "pattern": {
            "type": "string",
            "enum": [
              "square",
              "offset",
              "sfg"
            ]
          },
          "successions": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "intervalDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              }
            },
            "required": [
              "count"
            ],
            "additionalProperties": false
          },
          "note": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "cropPluginId",
          "start"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "pluginId",
    "displayName",
    "version",
    "type",
    "description",
    "bedSize",
    "steps"
  ],
  "additionalProperties": false
}
