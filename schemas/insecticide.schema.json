{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cropcard.dev/schemas/insecticide.schema.json",
  "title": "CropCard Insecticide Plugin",
  "description": "Data-only insecticide definition. Mirrors apps/web/src/lib/plugins/schemas.ts (insecticidePluginSchema).",
  "type": "object",
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "pluginSchemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "type": {
      "type": "string",
      "const": "insecticide"
    },
    "activeIngredients": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "iracGroup": {
            "type": "string",
            "pattern": "^[A-Z0-9]{1,4}$"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "defaultUnit": {
      "type": "string",
      "enum": [
        "fl-oz",
        "pt",
        "qt",
        "gal",
        "oz",
        "lb",
        "kg",
        "g",
        "count"
      ]
    },
    "formulation": {
      "type": "string",
      "enum": [
        "EC",
        "SL",
        "SC",
        "F",
        "L",
        "ME",
        "ES",
        "EW",
        "CS",
        "OD",
        "SE",
        "WDG",
        "WG",
        "DF",
        "SG",
        "SP",
        "WP",
        "WSP",
        "WS",
        "G",
        "D"
      ]
    },
    "reEntryIntervalHours": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "preHarvestIntervalDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ratePerAcre": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "oz",
            "fl-oz",
            "lb",
            "pt",
            "qt"
          ]
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "additionalProperties": false
    },
    "gpaCalibration": {
      "default": 15,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dilutionTable": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^\\d+gal$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "enum": [
              "oz",
              "fl-oz",
              "lb",
              "pt",
              "qt"
            ]
          },
          "display": {
            "type": "string"
          }
        },
        "required": [
          "amount",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "targetPests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pollinatorRisk": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "moderate",
        "high"
      ]
    },
    "pollinator": {
      "type": "object",
      "properties": {
        "beeToxicity": {
          "type": "string",
          "enum": [
            "highly-toxic",
            "toxic",
            "relatively-nontoxic",
            "unknown"
          ]
        },
        "bloomRestriction": {
          "type": "string",
          "enum": [
            "prohibited-during-bloom",
            "dusk-to-dawn-only",
            "none"
          ]
        },
        "residualToxicityHours": {
          "type": "number",
          "minimum": 0,
          "maximum": 720
        }
      },
      "required": [
        "beeToxicity",
        "bloomRestriction"
      ],
      "additionalProperties": false
    },
    "scoutingThresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pest": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "enum": [
              "count-per-plant",
              "count-per-leaf",
              "count-per-trap-per-week",
              "pct-defoliation",
              "pct-infested-plants",
              "eggs-per-plant"
            ]
          },
          "threshold": {
            "type": "number",
            "minimum": 0
          },
          "warnAt": {
            "type": "number",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "pest",
          "metric",
          "threshold"
        ],
        "additionalProperties": false
      }
    },
    "applicationProtocol": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "dayOffset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "step"
        ],
        "additionalProperties": false
      }
    },
    "epaRegistrationNumber": {
      "type": "string",
      "pattern": "^\\d{1,6}-\\d{1,6}(-\\d{1,6})?$"
    },
    "labelClaims": {
      "type": "object",
      "properties": {
        "safeForCropPluginIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safeForCropFamilies": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "corn",
              "cucurbit",
              "legume",
              "broadleaf-companion",
              "orchard",
              "cover-grass",
              "cover-legume",
              "solanaceae",
              "brassica",
              "allium",
              "leafy-green",
              "root",
              "apiaceae",
              "small-fruit",
              "bramble",
              "vine-fruit",
              "stone-fruit",
              "cereal-grain",
              "forage",
              "herb-culinary"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "complianceFlags": {
      "type": "object",
      "properties": {
        "omriListed": {
          "type": "boolean"
        },
        "nonGmoCompliant": {
          "type": "boolean"
        },
        "certifiedOrganicAllowed": {
          "type": "boolean"
        },
        "transitioningAllowed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "pluginId",
    "displayName",
    "version",
    "type",
    "activeIngredients",
    "reEntryIntervalHours"
  ],
  "additionalProperties": false
}
