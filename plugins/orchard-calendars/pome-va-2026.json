          "purpose": "bloom",
          "targets": [
            {
              "id": "fire-blight",
              "kind": "disease"
            },
            {
              "id": "warm-wet-bloom",
              "kind": "weather"
            }
          ],
          "pollinatorSensitive": true,
          "note": "Open flowers with petals can be infected when dew or rain comes on warm days. Flowers at petal fall resist infection.",
          "sourceKeys": ["pome-va-2026.bloom.fire-blight"]
        },
        {
          "id": "bloom-bees",
          "purpose": "bloom",
          "targets": [],
          "pollinatorSensitive": true,
          "sourceKeys": ["pome-va-2026.bloom.bees"]
        }
      ]
    },
