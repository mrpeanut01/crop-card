{
  "pluginId": "entrust-sc",
  "type": "insecticide",
  "displayName": "Entrust SC (Corteva spinosad — OMRI)",
  "version": "1.0.0",
  "activeIngredients": [
    {
      "name": "spinosad",
      "iracGroup": "5"
    }
  ],
  "reEntryIntervalHours": 4,
  "preHarvestIntervalDays": 1,
  "ratePerAcre": {
    "amount": 6,
    "unit": "fl-oz"
  },
