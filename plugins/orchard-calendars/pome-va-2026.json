{
  "pluginId": "pome-va-2026",
  "type": "orchard-calendar",
  "version": "1.1.0",
  "audience": "commercial",
  "guide": {
    "publisher": "Virginia Cooperative Extension (Virginia Tech, West Virginia University, University of Maryland Extension)",
    "title": "2026 Spray Bulletin for Commercial Tree Fruit Growers",
    "publicationId": "VCE 456-419",
    "url": "https://www.pubs.ext.vt.edu/456/456-419/456-419.html"
  },
  "edition": "2026",
  "hostCropFamilies": ["orchard"],
  "hostCropPluginIds": [
    "apple-cortland",
    "apple-fuji",
    "apple-gala",
    "apple-honeycrisp",
    "apple-orchard"
  ],
  "stages": [
    {
      "id": "dormant",
      "name": "Dormant",
      "order": 0,
      "recognise": {
        "description": "Fruit buds are inactive. This is the overwintering stage.",
        "sourceKey": "pome-va-2026.dormant.description"
      },
      "windows": [
        {
          "id": "dormant-blight-pruning",
          "purpose": "sanitation",
          "targets": [
            {
              "id": "fire-blight",
              "kind": "disease"
            }
          ],
          "pollinatorSensitive": false,
          "note": "Prune out every blighted limb and shoot each year so fewer cankers carry fire blight into spring.",
          "sourceKeys": ["pome-va-2026.dormant.fire-blight"]
        }
      ]
    },
    {
      "id": "silver-tip",
      "name": "Silver tip",
      "order": 1,
      "recognise": {
        "description": "Fruit bud scales have separated at the tip, showing light gray tissue.",
        "sourceKey": "pome-va-2026.silver-tip.description"
      },
      "windows": [
        {
          "id": "silver-tip-pests",
          "purpose": "pest-risk",
          "targets": [
            {
              "id": "san-jose-scale",
              "kind": "pest"
            },
            {
              "id": "rosy-apple-aphid",
              "kind": "pest"
            },
            {
              "id": "green-aphids",
              "kind": "pest"
            },
            {
              "id": "european-red-mite",
              "kind": "pest"
            }
          ],
          "pollinatorSensitive": false,
          "note": "Listed for silver tip through green tip. Aphids are harder to deal with once they are inside curled leaves.",
          "sourceKeys": [
            "pome-va-2026.silver-tip.pests",
            "pome-va-2026.silver-tip.aphids"
          ]
        }
      ]
    },
    {
      "id": "green-tip",
      "name": "Green tip",
      "order": 2,
      "recognise": {
        "description": "Fruit buds have broken at the tip, showing about a sixteenth of an inch of green.",
        "sourceKey": "pome-va-2026.green-tip.description"
      },
      "windows": [
        {
          "id": "green-tip-scab-weather",
          "purpose": "disease-risk",
          "targets": [
            {
              "id": "apple-scab",
              "kind": "disease"
            },
            {
              "id": "long-wet-periods",
              "kind": "weather"
            }
          ],
          "pollinatorSensitive": false,
          "note": "Scab spores from last year's fallen leaves are released in spring rains from about bud break. Watch for long wet periods.",
          "sourceKeys": ["pome-va-2026.green-tip.scab"]
        }
      ]
    },
    {
      "id": "half-inch-green",
      "name": "Half-inch green",
      "order": 3,
      "recognise": {
        "description": "About half an inch of leaf tissue sticks out of the fruit buds.",
        "sourceKey": "pome-va-2026.half-inch-green.description"
      },
      "windows": [
        {
          "id": "half-inch-green-scab",
          "purpose": "disease-risk",
          "targets": [
            {
              "id": "apple-scab",
              "kind": "disease"
            }
          ],
          "pollinatorSensitive": false,
          "note": "Primary scab season: new leaves can be infected from here on during long wet periods.",
          "sourceKeys": [
            "pome-va-2026.half-inch-green.diseases",
            "pome-va-2026.green-tip.scab"
          ]
        },
        {
          "id": "half-inch-green-pests",
          "purpose": "pest-risk",
          "targets": [
            {
              "id": "san-jose-scale",
              "kind": "pest"
            },
            {
              "id": "rosy-apple-aphid",
              "kind": "pest"
            },
            {
              "id": "green-aphids",
              "kind": "pest"
            },
            {
              "id": "european-red-mite",
              "kind": "pest"
            },
            {
              "id": "redbanded-leafroller",
              "kind": "pest"
            },
            {
              "id": "defoliating-caterpillars",
              "kind": "pest"
            },
            {
              "id": "oriental-fruit-moth",
              "kind": "pest"
            }
          ],
          "pollinatorSensitive": false,
          "note": "Defoliating caterpillars here are tent caterpillars, cankerworms and cutworms.",
          "sourceKeys": ["pome-va-2026.half-inch-green.pests"]
        }
      ]
    },
    {
      "id": "tight-cluster",
      "name": "Tight cluster",
      "order": 4,
      "recognise": {
        "description": "Blossom buds are mostly exposed and tightly grouped on short stems.",
        "sourceKey": "pome-va-2026.tight-cluster.description"
      },
      "windows": [
        {
          "id": "tight-cluster-diseases",
          "purpose": "disease-risk",
          "targets": [
            {
              "id": "apple-scab",
              "kind": "disease"
            },
            {
              "id": "powdery-mildew",
              "kind": "disease"
            },
            {
              "id": "apple-rusts",
              "kind": "disease"
            }
          ],
          "pollinatorSensitive": true,
          "note": "Listed for tight cluster to pre-pink.",
          "sourceKeys": ["pome-va-2026.tight-cluster.diseases"]
        },
        {
          "id": "tight-cluster-pests",
          "purpose": "pest-risk",
          "targets": [
            {
              "id": "rosy-apple-aphid",
              "kind": "pest"
            },
            {
              "id": "green-aphids",
              "kind": "pest"
            },
            {
              "id": "european-red-mite",
              "kind": "pest"
            },
            {
              "id": "green-fruitworm",
              "kind": "pest"
            },
            {
              "id": "tarnished-plant-bug",
              "kind": "pest"
            },
            {
              "id": "tentiform-leafminer",
              "kind": "pest"
            },
            {
              "id": "oriental-fruit-moth",
              "kind": "pest"
            }
          ],
          "pollinatorSensitive": true,
          "note": "Listed for tight cluster to pre-pink.",
          "sourceKeys": ["pome-va-2026.tight-cluster.pests"]
        },
        {
          "id": "tight-cluster-fruitworm-tap",
          "purpose": "scout",
          "targets": [
            {
              "id": "green-fruitworm",
              "kind": "pest"
            }
          ],
          "pollinatorSensitive": true,
          "note": "From pre-pink, tap limbs over a sheet. Green fruitworm larvae curl up when knocked loose.",
          "sourceKeys": ["pome-va-2026.tight-cluster.fruitworm"]
        },
        {
          "id": "tight-cluster-blight-cankers",
          "purpose": "disease-risk",
          "targets": [
            {
              "id": "fire-blight",
              "kind": "disease"
            }
          ],
          "pollinatorSensitive": true,
          "note": "Fire blight bacteria start multiplying in old cankers around tight cluster, weeks before any symptom shows.",
          "sourceKeys": ["pome-va-2026.tight-cluster.fire-blight"]
        }
      ]
    },
    {
      "id": "pink",
      "name": "Pink",
      "order": 5,
      "recognise": {
        "description": "Every blossom bud in the cluster is pink and the stems are fully extended.",
        "sourceKey": "pome-va-2026.pink.description"
