{
  "pluginId": "pear-va-2026",
  "type": "orchard-calendar",
  "version": "1.0.0",
  "edition": "2026",
  "hostCropFamilies": ["orchard"],
  "hostCropPluginIds": ["pear-bartlett", "pear-bosc"],
  "stages": [
    {
      "id": "dormant",
      "name": "Dormant",
      "order": 0,
      "recognise": {
        "description": "Fruit buds are inactive. This is the overwintering stage.",
        "sourceKey": "pear-va-2026.dormant.description"
      },
      "windows": [
        {
          "id": "dormant-blight-pruning",
          "purpose": "sanitation",
          "targets": [
            {
              "id": "fire-blight",
              "kind": "disease"
            }
          ],
          "pollinatorSensitive": false,
          "note": "Prune out every blighted limb and shoot each year so fewer cankers carry fire blight into spring.",
          "sourceKeys": [
            "pear-va-2026.dormant.fire-blight",
            "pear-va-2026.dormant.targets"
          ]
        }
      ]
    },
    {
      "id": "swollen-bud",
      "name": "Swollen bud",
      "order": 1,
      "recognise": {
        "description": "Fruit buds are swollen and the scales have separated, showing lighter tissue.",
        "sourceKey": "pear-va-2026.swollen-bud.description"
      },
      "windows": [
        {
          "id": "swollen-bud-psylla-eggs",
          "purpose": "scout",
          "targets": [
            {
              "id": "pear-psylla",
              "kind": "pest"
            }
          ],
          "pollinatorSensitive": false,
          "note": "Check buds with a hand lens for tiny yellow oval pear psylla eggs, usually found at bud swell.",
          "sourceKeys": ["pear-va-2026.swollen-bud.psylla"]
        }
      ]
    },
    {
      "id": "bud-burst",
      "name": "Bud burst",
      "order": 2,
