{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cropcard.dev/schemas/companion.schema.json",
  "title": "CropCard Companion-System Plugin",
  "description": "Multi-crop interplanting system (e.g., Three Sisters). Drives FR-15 companion advisor.",
  "type": "object",
  "required": ["schemaVersion", "pluginType", "id", "displayName", "members"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "pluginType": { "const": "companion-system" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "members": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["cropPluginId", "role"],
        "properties": {
          "cropPluginId": { "type": "string" },
          "role": { "type": "string", "enum": ["primary", "trellis", "ground-cover", "trap", "pollinator", "n-fixer"] },
          "plantingOffsetDays": { "type": "integer" },
          "plantingTrigger": { "type": "string" }
        }
      }
    },
    "benefits": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
