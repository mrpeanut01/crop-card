{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cropcard.dev/schemas/companion.schema.json",
  "title": "CropCard Companion Plugin",
  "description": "Data-only companion-planting definition (goodWith / badWith / member-system). Mirrors apps/web/src/lib/plugins/schemas.ts (companionPluginSchema).",
  "type": "object",
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "pluginSchemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "type": {
      "type": "string",
      "const": "companion"
    },
    "goodWith": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "badWith": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primaryFamily": {
      "type": "string",
      "enum": [
        "corn",
        "cucurbit",
        "legume",
        "broadleaf-companion",
        "orchard",
        "cover-grass",
        "cover-legume",
        "solanaceae",
        "brassica",
        "allium",
        "leafy-green",
        "root",
        "apiaceae",
        "small-fruit",
        "bramble",
        "vine-fruit",
        "stone-fruit",
        "cereal-grain",
        "forage",
        "herb-culinary"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "enum": [
              "corn",
              "cucurbit",
              "legume",
              "broadleaf-companion",
              "orchard",
              "cover-grass",
              "cover-legume",
              "solanaceae",
              "brassica",
              "allium",
              "leafy-green",
              "root",
              "apiaceae",
              "small-fruit",
              "bramble",
              "vine-fruit",
              "stone-fruit",
              "cereal-grain",
              "forage",
              "herb-culinary"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "plantingOffsetDays": {
            "type": "integer",
            "minimum": -365,
            "maximum": 365
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "body": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "family",
          "role",
          "plantingOffsetDays"
        ],
        "additionalProperties": false
      }
    },
    "benefit": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "pluginId",
    "displayName",
    "version",
    "type"
  ],
  "additionalProperties": false
}
