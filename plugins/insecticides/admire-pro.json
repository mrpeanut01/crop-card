{
  "pluginId": "admire-pro",
  "type": "insecticide",
  "displayName": "Admire Pro (Bayer imidacloprid)",
  "version": "1.0.0",
  "activeIngredients": [
    {
      "name": "imidacloprid",
      "iracGroup": "4A"
    }
  ],
  "reEntryIntervalHours": 12,
  "preHarvestIntervalDays": 7,
  "ratePerAcre": {
    "amount": 7,
    "unit": "fl-oz"
  },
  "targetPests": [
    "aphid",
    "Colorado potato beetle",
    "whitefly",
    "cucumber beetle",
    "flea beetle",
    "leafhopper"
  ],
  "pollinatorRisk": "high",
  "notes": "Neonicotinoid IRAC 4A. Soil-applied + foliar. Highly bee-toxic — never apply during bloom; soil application before bloom only.",
  "complianceFlags": {
    "omriListed": false,
    "certifiedOrganicAllowed": false,
    "nonGmoCompliant": true,
    "transitioningAllowed": false
  },
  "pluginSchemaVersion": "1.1",
  "scoutingThresholds": [
    {
      "pest": "aphid",
      "metric": "count-per-leaf",
      "threshold": 50,
      "warnAt": 30
    },
    {
      "pest": "Colorado potato beetle",
      "metric": "count-per-plant",
      "threshold": 2,
      "warnAt": 1
    },
    {
      "pest": "whitefly",
      "metric": "count-per-leaf",
      "threshold": 5,
      "warnAt": 3
    },
    {
      "pest": "cucumber beetle",
      "metric": "count-per-plant",
      "threshold": 1
    },
    {
      "pest": "flea beetle",
      "metric": "pct-defoliation",
      "threshold": 20,
      "warnAt": 10
    },
    {
      "pest": "leafhopper",
      "metric": "count-per-leaf",
      "threshold": 1
    }
  ]
}
