{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cropcard.dev/schemas/fungicide.schema.json",
  "title": "CropCard Fungicide Plugin",
  "description": "Data-only fungicide definition. Mirrors apps/web/src/lib/plugins/schemas.ts (fungicidePluginSchema). New in Phase 9; first published in Phase 21.",
  "type": "object",
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "pluginSchemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "type": {
      "type": "string",
      "const": "fungicide"
    },
    "activeIngredients": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "fracCode": {
            "type": "string",
            "pattern": "^(M\\d{2}|P\\d{2}|U\\d{2}|BM\\d{2}|NC|\\d{1,3})$"
          }
        },
        "required": [
          "name",
          "fracCode"
        ],
        "additionalProperties": false
      }
    },
    "defaultUnit": {
      "type": "string",
      "enum": [
        "fl-oz",
        "pt",
        "qt",
        "gal",
        "oz",
        "lb",
        "kg",
        "g",
        "count"
      ]
    },
    "formulation": {
      "type": "string",
      "enum": [
        "EC",
        "SL",
        "SC",
        "F",
        "L",
        "ME",
        "ES",
        "EW",
        "CS",
        "OD",
        "SE",
        "ZC",
        "WDG",
        "WG",
        "DF",
        "SG",
        "SP",
        "WP",
        "WSP",
        "WS",
        "G",
        "D"
      ]
    },
    "applicationTiming": {
      "type": "string",
      "enum": [
        "DORMANT",
        "PRE-BLOOM",
        "BLOOM",
        "POST-BLOOM",
        "COVER",
        "PRE-HARVEST"
      ]
    },
    "ratePerAcre": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "oz",
            "fl-oz",
            "lb",
            "pt",
            "qt"
          ]
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "additionalProperties": false
    },
    "gpaCalibration": {
      "default": 15,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dilutionTable": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^\\d+gal$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "enum": [
              "oz",
              "fl-oz",
              "lb",
              "pt",
              "qt"
            ]
          },
          "display": {
            "type": "string"
          }
        },
        "required": [
          "amount",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "reEntryIntervalHours": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "preHarvestIntervalDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rainfastHours": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 72
    },
    "pollinatorRisk": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "moderate",
        "high"
      ]
    },
    "deconRequired": {
      "type": "boolean"
    },
    "targetDiseases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "epaRegistrationNumber": {
      "type": "string",
      "pattern": "^\\d{1,6}-\\d{1,6}(-\\d{1,6})?$"
    },
    "labelClaims": {
      "type": "object",
      "properties": {
        "safeForCropPluginIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safeForCropFamilies": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "corn",
              "cucurbit",
              "legume",
              "broadleaf-companion",
              "orchard",
              "cover-grass",
              "cover-legume",
              "solanaceae",
              "brassica",
              "allium",
              "leafy-green",
              "root",
              "apiaceae",
              "small-fruit",
              "bramble",
              "vine-fruit",
              "stone-fruit",
              "cereal-grain",
              "forage",
              "herb-culinary"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "complianceFlags": {
      "type": "object",
      "properties": {
        "omriListed": {
          "type": "boolean"
        },
        "nonGmoCompliant": {
          "type": "boolean"
        },
        "certifiedOrganicAllowed": {
          "type": "boolean"
        },
        "transitioningAllowed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "pluginId",
    "displayName",
    "version",
    "type",
    "activeIngredients",
    "ratePerAcre",
    "reEntryIntervalHours",
    "preHarvestIntervalDays"
  ],
  "additionalProperties": false
}
