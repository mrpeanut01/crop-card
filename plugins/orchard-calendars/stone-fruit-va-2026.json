      "order": 4,
      "recognise": {
        "description": "About three quarters of the petals have fallen.",
        "sourceKey": "stone-fruit-va-2026.petal-fall.description"
      },
      "windows": [
        {
          "id": "petal-fall-diseases",
          "purpose": "disease-risk",
          "targets": [
            {
              "id": "brown-rot",
              "kind": "disease"
            },
            {
              "id": "peach-scab",
              "kind": "disease"
            },
            {
              "id": "rusty-spot",
              "kind": "disease"
            }
          ],
          "pollinatorSensitive": true,
          "note": "Check the label.",
          "sourceKeys": ["stone-fruit-va-2026.petal-fall.diseases"]
        },
        {
          "id": "petal-fall-pests",
          "purpose": "pest-risk",
          "targets": [
            {
              "id": "tarnished-plant-bug",
              "kind": "pest"
            },
            {
              "id": "stink-bugs",
              "kind": "pest"
            },
            {
              "id": "green-peach-aphid",
              "kind": "pest"
            },
            {
              "id": "plum-curculio",
              "kind": "pest"
            },
            {
              "id": "western-flower-thrips",
              "kind": "pest"
            }
          ],
          "pollinatorSensitive": true,
          "note": "Bees may still be on late flowers. Check the label.",
          "sourceKeys": ["stone-fruit-va-2026.petal-fall.pests"]
        }
      ]
    },
    {
      "id": "shuck-split",
      "name": "Shuck split and shuck fall",
      "order": 5,
      "recognise": {
        "description": "The dried flower remnant covering the young fruit splits and soon falls away.",
        "sourceKey": "stone-fruit-va-2026.shuck-split.description"
      },
      "windows": [
        {
          "id": "shuck-diseases",
          "purpose": "disease-risk",
          "targets": [
            {
              "id": "peach-scab",
              "kind": "disease"
            },
            {
              "id": "brown-rot",
              "kind": "disease"
            },
            {
              "id": "rusty-spot",
              "kind": "disease"
            }
          ],
          "pollinatorSensitive": false,
          "note": "Check the label.",
          "sourceKeys": ["stone-fruit-va-2026.shuck-split.diseases"]
        },
        {
          "id": "shuck-pests",
          "purpose": "pest-risk",
          "targets": [
            {
              "id": "tarnished-plant-bug",
              "kind": "pest"
            },
            {
              "id": "stink-bugs",
              "kind": "pest"
            },
            {
              "id": "green-peach-aphid",
              "kind": "pest"
            },
            {
              "id": "plum-curculio",
              "kind": "pest"
            },
            {
              "id": "oriental-fruit-moth",
              "kind": "pest"
            },
            {
              "id": "lesser-peachtree-borer",
              "kind": "pest"
            },
            {
              "id": "white-peach-scale",
              "kind": "pest"
            }
