{
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "$id": "https://cropcard.dev/schemas/fertilizer.schema.json",
  "title": "CropCard Fertilizer Plugin",
  "description": "Data-only fertilizer definition. Mirrors apps/web/src/lib/plugins/schemas.ts (fertilizerPluginSchema). The existing `organic` boolean is the source of truth for organic-source amendments; complianceFlags (Phase 21) adds the NOP / OMRI distinction.",
  "type": "object",
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "pluginSchemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "type": {
      "type": "string",
      "const": "fertilizer"
    },
    "analysis": {
      "type": "object",
      "properties": {
        "n": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "p": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "k": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "n",
        "p",
        "k"
      ],
      "additionalProperties": false
    },
    "form": {
      "type": "string",
      "enum": [
        "granular",
        "liquid",
        "soluble",
        "compost",
        "slow-release",
        "meal"
      ]
    },
    "organic": {
      "type": "boolean",
      "default": false
    },
    "secondaryNutrients": {
      "type": "object",
      "properties": {
        "ca": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "mg": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "s": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "b": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "zn": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "mn": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "cu": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "fe": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "applicationRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "exclusiveMinimum": true,
          "minimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": true,
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "lb-per-acre",
            "gal-per-acre",
            "ton-per-acre"
          ]
        }
      },
      "required": [
        "min",
        "max",
        "unit"
      ],
      "additionalProperties": false
    },
    "complianceFlags": {
      "type": "object",
      "properties": {
        "omriListed": {
          "type": "boolean"
        },
        "nonGmoCompliant": {
          "type": "boolean"
        },
        "certifiedOrganicAllowed": {
          "type": "boolean"
        },
        "transitioningAllowed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "pluginId",
    "displayName",
    "version",
    "type",
    "analysis",
    "form"
  ],
  "additionalProperties": false
}
