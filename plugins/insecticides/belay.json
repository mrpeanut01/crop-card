      "pest": "aphid",
      "metric": "count-per-leaf",
      "threshold": 50,
      "warnAt": 30
    },
    {
      "pest": "flea beetle",
      "metric": "pct-defoliation",
      "threshold": 20,
      "warnAt": 10
    },
    {
      "pest": "stink bug",
      "metric": "count-per-plant",
      "threshold": 1
    },
    {
      "pest": "leafhopper",
      "metric": "count-per-leaf",
      "threshold": 1
    },
    {
      "pest": "cucumber beetle",
      "metric": "count-per-plant",
      "threshold": 1
    },
    {
      "pest": "Colorado potato beetle",
      "metric": "count-per-plant",
      "threshold": 2,
      "warnAt": 1
    }
  ]
