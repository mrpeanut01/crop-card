{
  "name": "@cropcard/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint --rulesdir ./eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "rm -f /data/cropcard.db && pnpm db:migrate",
    "seed:test": "node scripts/seed-test-data.mjs",
    "gen:schemas": "tsx scripts/gen-schemas.mjs",
    "gen:openapi": "node scripts/gen-openapi.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@sveltejs/adapter-node": "^5.2.9",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.3.15",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vite-pwa/sveltekit": "^0.6.7",
    "drizzle-kit": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.0",
    "fast-check": "^3.23.1",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.8",
    "svelte": "^5.1.16",
    "svelte-check": "^4.0.7",
    "tsx": "^4.22.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@auth/sveltekit": "^1.7.4",
    "@cropcard/plugin-validation": "workspace:*",
    "@geoman-io/leaflet-geoman-free": "^2.18.0",
    "@zxing/library": "^0.23.0",
    "better-sqlite3": "^11.5.0",
    "dexie": "^4.0.10",
    "drizzle-orm": "^0.36.4",
    "leaflet": "^1.9.4",
    "papaparse": "^5.4.1",
    "pdfmake": "^0.2.15",
    "zod": "^3.23.8"
  }
}
