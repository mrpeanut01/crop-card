    "stink bug",
    "leafhopper",
    "cucumber beetle",
    "Colorado potato beetle"
  ],
  "pollinatorRisk": "high",
  "notes": "Neonicotinoid IRAC 4A. Brassica / cucurbit / fruiting / leafy label. NO bloom application.",
  "complianceFlags": {
    "omriListed": false,
    "certifiedOrganicAllowed": false,
    "nonGmoCompliant": true,
    "transitioningAllowed": false
  },
  "pluginSchemaVersion": "1.1",
