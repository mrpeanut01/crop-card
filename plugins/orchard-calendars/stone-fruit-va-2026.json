              "id": "brown-rot",
              "kind": "disease"
            }
          ],
          "pollinatorSensitive": false,
          "note": "Thin every variety before pit hardening. Fruit thinned later can feed brown rot later in the season.",
          "sourceKeys": ["stone-fruit-va-2026.shuck-split.thinning"]
        }
      ]
    },
    {
      "id": "covers",
      "name": "Covers",
      "order": 6,
      "recognise": {
        "description": "After shuck fall, at intervals of no more than 14 days.",
        "sourceKey": "stone-fruit-va-2026.covers.description"
      },
      "windows": [
        {
          "id": "cover-diseases",
          "purpose": "disease-risk",
          "targets": [
            {
              "id": "peach-scab",
              "kind": "disease"
            },
            {
              "id": "brown-rot",
              "kind": "disease"
            },
            {
              "id": "rusty-spot",
              "kind": "disease"
            }
          ],
          "pollinatorSensitive": false,
          "note": "The guide drops brown rot protection for green fruit after pit hardening and takes it up again as fruit colors or when the weather favors brown rot. Check the label.",
          "sourceKeys": ["stone-fruit-va-2026.covers.diseases"]
        },
        {
          "id": "cover-pests",
          "purpose": "pest-risk",
          "targets": [
            {
