{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cropcard.dev/schemas/pest-model.schema.json",
  "title": "CropCard Pest-Model Plugin",
  "description": "Data-only degree-day pest model. method names one of the degree-day methods the app implements and never carries a formula; stage advice is about scouting or covering, never spraying. Every number needs a quoted source in apps/web/scripts/pest-model-sources.json. Loaded from plugins/pest-models/. Mirrors packages/plugin-validation/src/schemas.ts (pestModelPluginSchema).",
  "type": "object",
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "pluginSchemaVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "type": {
      "type": "string",
      "const": "pest-model"
    },
    "pest": {
      "type": "object",
      "properties": {
        "commonName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "scientificName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "commonName"
      ],
      "additionalProperties": false
    },
    "hostCropFamilies": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "corn",
          "cucurbit",
          "legume",
          "broadleaf-companion",
          "orchard",
          "cover-grass",
          "cover-legume",
          "solanaceae",
          "brassica",
          "allium",
          "leafy-green",
          "root",
          "apiaceae",
          "small-fruit",
          "bramble",
          "vine-fruit",
          "stone-fruit",
          "cereal-grain",
          "forage",
          "herb-culinary"
        ]
      }
    },
    "method": {
      "type": "string",
      "enum": [
        "simple-average",
        "single-sine"
      ]
    },
    "baseTempF": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "upperCutoffF": {
      "type": "number",
      "minimum": 0,
      "maximum": 130
    },
    "biofix": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "january-1",
            "calendar-date",
            "first-trap-catch"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "stages": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "gddFrom": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "gddTo": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "action": {
            "type": "string",
            "enum": [
              "scout",
              "set-traps",
              "cover",
              "uncover",
              "hand-pick"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "key",
          "label",
          "gddFrom",
          "action",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "pluginId",
    "displayName",
    "version",
    "type",
    "pest",
    "hostCropFamilies",
    "method",
    "baseTempF",
    "biofix",
    "stages"
  ],
  "additionalProperties": false
}
