        }
      ]
    },
    {
      "id": "preharvest",
      "name": "Pre-harvest",
      "order": 7,
      "recognise": {
        "description": "The last two to three weeks before harvest.",
        "sourceKey": "stone-fruit-va-2026.preharvest.description"
      },
      "windows": [
        {
          "id": "preharvest-rots",
          "purpose": "disease-risk",
          "targets": [
            {
              "id": "brown-rot",
              "kind": "disease"
            },
            {
              "id": "rhizopus-rot",
              "kind": "disease"
            }
          ],
          "pollinatorSensitive": false,
          "note": "Check the label.",
          "sourceKeys": ["stone-fruit-va-2026.preharvest.diseases"]
        }
      ]
    },
    {
      "id": "fall",
      "name": "Early leaf drop",
      "order": 8,
      "recognise": {
        "description": "Early leaf drop in the fall, after harvest.",
        "sourceKey": "stone-fruit-va-2026.fall.description"
      },
      "windows": [
        {
          "id": "after-harvest-sanitation",
          "purpose": "sanitation",
          "targets": [
            {
              "id": "brown-rot",
              "kind": "disease"
            }
          ],
          "pollinatorSensitive": false,
          "note": "Pick off all fruit left on the trees after the last harvest, and do not dump rotten fruit in one spot.",
          "sourceKeys": ["stone-fruit-va-2026.preharvest.sanitation"]
        },
        {
          "id": "fall-leaf-scars",
          "purpose": "disease-risk",
          "targets": [
            {
              "id": "bacterial-spot",
              "kind": "disease"
            },
            {
              "id": "peach-leaf-curl",
              "kind": "disease"
            }
          ],
          "pollinatorSensitive": false,
          "note": "Where bacterial spot or leaf curl has been a problem, leaf scars can be infected at early leaf drop and carry the disease over winter. Check the label.",
          "sourceKeys": [
            "stone-fruit-va-2026.fall.leaf-scars",
            "stone-fruit-va-2026.fall.description"
          ]
        }
      ]
